FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

application     moistureDiffusivityFoam;

startFrom       latestTime;

stopAt          endTime;

endTime         5e-5;

deltaT          1e-05;

writeControl    adjustableRunTime;

writeInterval   1e-5;

purgeWrite      0;

writeFormat     ascii;

writePrecision  12;

writeCompression no;

timeFormat      general;

timePrecision   6;

adjustTimeStep  no;

runTimeModifiable no;
