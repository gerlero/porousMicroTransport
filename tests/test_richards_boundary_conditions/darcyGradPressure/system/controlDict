FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

application     microRichardsFoam;

startFrom       latestTime;
stopAt          endTime;
endTime         0.1;
deltaT          1e-5;

writeControl    adjustableRunTime;
writeInterval   0.02;
writeFormat     ascii;
writePrecision  10;
writeCompression no;
timeFormat      general;
timePrecision   8;

adjustTimeStep  yes;
maxDeltaT       0.01;
runTimeModifiable no;
